[
  {
    "kernelSource": {
      "name": "shirkneko-KernelSU-docker-release",
      "repo": "https://github.com/ShirkNeko/kernel_xiaomi_raphael_bool-x",
      "branch": "main",
      "device": "raphael",
      "defconfig": "raphael_defconfig"
    },
    "withKernelSU": true,
    "toolchains": [
      {
        "repo": "https://gitlab.com/onettboots/boolx-clang",
        "branch": "Clang-15.0",
        "name": "boolx-clang",
        "binPath": ["bin"]
      }
    ],
    "ccache": false,
    "params": {
      "ARCH": "arm64",
      "CC": "boolx-clang/bin/clang",
      "externalCommand": {
        "CROSS_COMPILE": "boolx-clang/bin/aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "boolx-clang/bin/arm-linux-gnueabi-",
        "LD": "boolx-clang/bin/ld.lld",
        "AR": "boolx-clang/bin/llvm-ar",
        "NM": "boolx-clang/bin/llvm-nm",
        "OBJCOPY": "boolx-clang/bin/llvm-objcopy",
        "OBJDUMP": "boolx-clang/bin/llvm-objdump",
        "READELF": "boolx-clang/bin/llvm-readelf",
        "OBJSIZE": "boolx-clang/bin/llvm-size",
        "STRIP": "boolx-clang/bin/llvm-strip",
        "LDGOLD": "boolx-clang/bin/aarch64-linux-gnu-ld.gold",
        "LLVM_AR": "boolx-clang/bin/llvm-ar",
        "LLVM_DIS": "boolx-clang/bin/llvm-dis"
      }
    },
    "AnyKernel3": {
      "use": true,
      "release": true,
      "repo": "https://github.com/onettboots/boolx_anykernel",
      "branch": "unroot"
    }
  }
]
